{
  "version": 1,
  "hooks": {
    "afterAgentResponse": [
      {
        "command": "python3 ./hooks/lexical-guard/adapters/cursor/cursor_hook.py audit",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": "python3 ./hooks/lexical-guard/adapters/cursor/cursor_hook.py enforce",
        "timeout": 10,
        "loop_limit": 1
      }
    ]
  }
}
